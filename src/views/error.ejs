<div class="max-w-xl mx-auto px-5 py-24 text-center">
    <div class="font-display text-8xl font-semibold text-moss/20"><%= typeof statusCode !== 'undefined' ? statusCode : 500 %></div>
    <h1 class="font-display text-3xl font-semibold mt-4 mb-2"><%= typeof message !== 'undefined' ? message : 'Something went wrong' %></h1>
    <p class="text-ink/50 mb-8">The page you're looking for isn't here.</p>
    <a href="/" class="inline-block bg-ink text-paper font-medium px-6 py-3 rounded-full hover:bg-moss transition">Back to stories</a>
</div>
