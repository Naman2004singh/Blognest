<div class="max-w-md mx-auto px-5 py-16">
    <div class="text-center mb-10">
        <h1 class="font-display text-4xl font-semibold mb-2">Start writing</h1>
        <p class="text-ink/50">Create your account in a minute.</p>
    </div>

    <form id="registerForm" class="space-y-5">
        <div>
            <label class="block text-sm font-medium text-ink/70 mb-1.5">Full name</label>
            <input name="fullName" type="text" required
                class="w-full bg-white border border-ink/15 rounded-xl px-4 py-3 outline-none focus:border-moss focus:ring-2 focus:ring-moss/20 transition" />
        </div>
        <div>
            <label class="block text-sm font-medium text-ink/70 mb-1.5">Email</label>
            <input name="email" type="email" required autocomplete="email"
                class="w-full bg-white border border-ink/15 rounded-xl px-4 py-3 outline-none focus:border-moss focus:ring-2 focus:ring-moss/20 transition" />
        </div>
        <div>
            <label class="block text-sm font-medium text-ink/70 mb-1.5">Password</label>
            <input name="password" type="password" required minlength="6" autocomplete="new-password"
                class="w-full bg-white border border-ink/15 rounded-xl px-4 py-3 outline-none focus:border-moss focus:ring-2 focus:ring-moss/20 transition" />
            <p class="text-xs text-ink/40 mt-1">At least 6 characters.</p>
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-ink/70 mb-1.5">Avatar</label>
                <label class="flex flex-col items-center justify-center h-24 bg-white border border-dashed border-ink/25 rounded-xl cursor-pointer hover:border-moss transition text-center px-2">
                    <span id="avatarLabel" class="text-xs text-ink/50">Click to upload</span>
                    <input name="avatar" type="file" accept="image/*" required class="hidden"
                        onchange="document.getElementById('avatarLabel').textContent = this.files[0]?.name || 'Click to upload'" />
                </label>
            </div>
            <div>
                <label class="block text-sm font-medium text-ink/70 mb-1.5">Cover <span class="text-ink/40 font-normal">(optional)</span></label>
                <label class="flex flex-col items-center justify-center h-24 bg-white border border-dashed border-ink/25 rounded-xl cursor-pointer hover:border-moss transition text-center px-2">
                    <span id="coverLabel" class="text-xs text-ink/50">Click to upload</span>
                    <input name="coverImage" type="file" accept="image/*" class="hidden"
                        onchange="document.getElementById('coverLabel').textContent = this.files[0]?.name || 'Click to upload'" />
                </label>
            </div>
        </div>

        <button type="submit" id="submitBtn" data-loading-text="Creating account…"
            class="w-full bg-ink text-paper font-medium py-3 rounded-xl hover:bg-moss transition">
            Create account
        </button>
    </form>

    <p class="text-sm text-ink/50 mt-8 text-center">
        Already have an account?
        <a href="/login" class="text-moss font-medium hover:underline">Sign in</a>
    </p>
</div>

<%- include('../partials/ui-helpers') %>
<script>
    const form = document.getElementById("registerForm");
    const submitBtn = document.getElementById("submitBtn");

    form.addEventListener("submit", async (e) => {
        e.preventDefault();
        setLoading(submitBtn, true);

        try {
            const res = await fetch("/api/v1/users/register", {
                method: "POST",
                body: new FormData(form),
            });
            const data = await res.json();

            if (!res.ok) {
                toast(data.message || "Couldn't create account.");
                setLoading(submitBtn, false);
                return;
            }

            toast("Account created", "success");
            setTimeout(() => (window.location.href = "/login"), 500);
        } catch (err) {
            toast("Network error. Please try again.");
            setLoading(submitBtn, false);
        }
    });
</script>
