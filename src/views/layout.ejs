<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : 'BlogNest' %> · BlogNest</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Display: Fraunces (characterful serif). Body/UI: Plus Jakarta Sans. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        display: ['Fraunces', 'serif'],
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        ink: '#14201b',        
                        paper: '#faf9f6',      
                        moss: '#1f6b4f',       // primary
                        'moss-dark': '#164f3a',
                        clay: '#c05f3c',       // secondary
                    },
                },
            },
        };
    </script>

    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: #faf9f6; color: #14201b; }
        .font-display { font-family: 'Fraunces', serif; }
        .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
        /* button loading spinner */
        .spinner { width: 16px; height: 16px; border: 2px solid rgba(255,255,255,.4); border-top-color: #fff; border-radius: 50%; animation: spin .6s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
        @media (prefers-reduced-motion: reduce) { .spinner { animation: none; } }
    </style>
</head>
<body class="min-h-screen flex flex-col antialiased">

    <%- include('partials/navbar') %>

    <main class="flex-1 w-full">
        <%- body %>
    </main>

    <footer class="border-t border-ink/10 mt-20">
        <div class="max-w-5xl mx-auto px-5 py-8 flex items-center justify-between text-sm text-ink/50">
            <span class="font-display text-lg font-semibold text-ink">BlogNest</span>
            <span>Words worth keeping.</span>
        </div>
    </footer>

</body>
</html>
