
<header class="border-b border-ink/10 sticky top-0 bg-paper/85 backdrop-blur-md z-30">
    <div class="max-w-5xl mx-auto px-5 h-[72px] flex items-center justify-between gap-4">

        <!-- Brand: mark + wordmark -->
        <a href="/" class="flex items-center gap-2.5 group">
            <span class="grid place-items-center w-9 h-9 rounded-xl bg-ink text-paper group-hover:bg-moss transition">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
            </span>
            <span class="font-display text-2xl font-semibold tracking-tight text-ink">BlogNest</span>
        </a>

        <!-- Right side -->
        <nav class="flex items-center gap-5">
            <a href="/" class="hidden sm:inline text-[15px] font-medium text-ink/60 hover:text-ink transition">Stories</a>

            <% if (user) { %>
                <a href="/blogs/new"
                class="hidden sm:inline-flex items-center gap-1.5 text-[15px] font-medium text-ink/70 hover:text-ink transition">
                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                    Write
                </a>
                <a href="/dashboard" class="text-[15px] font-medium text-ink/70 hover:text-ink transition">
                    <%= user.role === 'user' ? 'Dashboard' : (user.role === 'admin' ? 'Admin' : 'Console') %>
                </a>

                <div class="flex items-center gap-2.5 pl-3 border-l border-ink/10">
                    <img src="<%= user.avatar %>" alt="" class="w-8 h-8 rounded-full object-cover ring-1 ring-ink/10" />
                    <div class="hidden md:flex flex-col leading-tight">
                        <span class="text-[13px] font-semibold text-ink"><%= user.fullName %></span>
                        <span class="text-[11px] font-medium
                            <% if (user.role === 'superadmin') { %> text-clay
                            <% } else if (user.role === 'admin') { %> text-moss
                            <% } else { %> text-ink/40 <% } %>">
                            <%= user.role === 'user' ? 'Member' : user.role %>
                        </span>
                    </div>
                    <button onclick="doLogout(event)" title="Sign out"
                            class="ml-1 text-ink/40 hover:text-clay transition">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    </button>
                </div>
            <% } else { %>
                <a href="/login" class="text-[15px] font-medium text-ink/70 hover:text-ink transition">Sign in</a>
                <a href="/register"
                class="bg-ink text-paper text-[15px] font-medium px-5 py-2 rounded-full hover:bg-moss transition">
                    Start writing
                </a>
            <% } %>
        </nav>
    </div>
</header>

<script>
    async function doLogout(e) {
        e.preventDefault();
        await fetch("/api/v1/users/logout", { method: "POST" });
        window.location.href = "/";
    }
</script>
