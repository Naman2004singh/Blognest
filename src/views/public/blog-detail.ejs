<article class="max-w-2xl mx-auto px-5 py-12">
    <!-- meta -->
    <div class="flex items-center gap-2 text-sm mb-5">
        <span class="px-3 py-1 rounded-full bg-moss/10 text-moss font-medium"><%= blog.category %></span>
        <span class="text-ink/40"><%= new Date(blog.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></span>
    </div>

    <h1 class="font-display text-4xl sm:text-5xl font-semibold leading-[1.1] mb-6"><%= blog.title %></h1>

    <!-- author row -->
    <div class="flex items-center gap-3 pb-8 mb-8 border-b border-ink/10">
        <div class="w-10 h-10 rounded-full bg-moss/15 flex items-center justify-center text-moss font-semibold">
            <%= blog.authorName.charAt(0).toUpperCase() %>
        </div>
        <div class="leading-tight">
            <div class="font-semibold text-ink"><%= blog.authorName %></div>
            <div class="text-sm text-ink/45">Author</div>
        </div>

        <% if (user && (user.id === blog.author || user.role === 'admin' || user.role === 'superadmin')) { %>
            <div class="ml-auto flex items-center gap-2">
                <a href="/blogs/<%= blog.id %>/edit"
                class="px-4 py-1.5 rounded-full border border-ink/15 text-sm font-medium text-ink/70 hover:border-moss hover:text-moss transition">Edit</a>
                <button id="deleteBtn" data-id="<%= blog.id %>" data-loading-text="Deleting…"
                class="px-4 py-1.5 rounded-full border border-clay/30 text-sm font-medium text-clay hover:bg-clay hover:text-white transition">Delete</button>
            </div>
        <% } %>
    </div>

    <!-- controlled hero image: fixed aspect, never oversized -->
    <div class="aspect-[16/9] rounded-2xl overflow-hidden bg-ink/5 mb-10">
        <img src="<%= blog.thumbnail %>" alt="" class="w-full h-full object-cover" />
    </div>

    <!-- body -->
    <div class="font-display text-xl leading-[1.8] text-ink/85 whitespace-pre-line"><%= blog.description %></div>

    <!-- actions -->
    <div class="flex items-center gap-4 border-y border-ink/10 py-4 mt-12">
        <button id="likeBtn" data-id="<%= blog.id %>"
            class="flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-ink/15 hover:border-moss transition font-medium">
            <svg id="likeIcon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            <span id="likeCount"><%= blog.likeCount %></span>
        </button>
        <span class="text-ink/45 text-sm"><%= comments.length %> comments</span>
    </div>
</article>

<!-- comments -->
<section class="max-w-2xl mx-auto px-5 pb-16">
    <h3 class="font-display text-2xl font-semibold mb-5">Comments</h3>

    <% if (user) { %>
        <div class="mb-8">
            <textarea id="commentInput" rows="3" placeholder="Share your thoughts…"
                class="w-full bg-white border border-ink/15 rounded-xl px-4 py-3 outline-none focus:border-moss focus:ring-2 focus:ring-moss/20 transition"></textarea>
            <button id="commentBtn" data-id="<%= blog.id %>" data-loading-text="Posting…"
                class="mt-2 bg-ink text-paper font-medium px-5 py-2 rounded-full hover:bg-moss transition">
                Post comment
            </button>
        </div>
    <% } else { %>
        <p class="text-ink/50 mb-8 bg-white border border-ink/10 rounded-xl px-4 py-3">
            <a href="/login" class="text-moss font-medium hover:underline">Sign in</a> to like or comment.
        </p>
    <% } %>

    <div id="commentList" class="space-y-5">
        <% comments.forEach(function(c) { %>
            <div class="flex gap-3">
                <div class="w-9 h-9 rounded-full bg-ink/10 flex items-center justify-center text-ink/60 font-semibold text-sm shrink-0">
                    <%= c.authorName.charAt(0).toUpperCase() %>
                </div>
                <div>
                    <div class="text-sm font-semibold text-ink"><%= c.authorName %></div>
                    <div class="text-ink/75 mt-0.5"><%= c.content %></div>
                </div>
            </div>
        <% }); %>
    </div>
</section>

<div id="pageData" data-logged-in="<%= user ? 'true' : 'false' %>" hidden></div>

<%- include('../partials/ui-helpers') %>
<script>
    const isLoggedIn = document.getElementById("pageData").dataset.loggedIn === "true";

    // like
    const likeBtn = document.getElementById("likeBtn");
    likeBtn?.addEventListener("click", async () => {
        if (!isLoggedIn) { window.location.href = "/login"; return; }
        try {
            const res = await fetch(`/api/v1/blogs/${likeBtn.dataset.id}/like`, { method: "POST" });
            const { data } = await res.json();
            document.getElementById("likeCount").textContent = data.likeCount;
            document.getElementById("likeIcon").setAttribute("fill", data.liked ? "currentColor" : "none");
            likeBtn.classList.toggle("text-moss", data.liked);
            likeBtn.classList.toggle("border-moss", data.liked);
        } catch { toast("Couldn't update like."); }
    });

    // comment
    const commentBtn = document.getElementById("commentBtn");
    commentBtn?.addEventListener("click", async () => {
        const content = document.getElementById("commentInput").value.trim();
        if (!content) { toast("Write something first.", "info"); return; }
        setLoading(commentBtn, true);
        try {
            const res = await fetch(`/api/v1/blogs/${commentBtn.dataset.id}/comments`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ content }),
            });
            if (res.ok) { location.reload(); }
            else { const d = await res.json(); toast(d.message || "Couldn't post."); setLoading(commentBtn, false); }
        } catch { toast("Network error."); setLoading(commentBtn, false); }
    });

    // delete
    const deleteBtn = document.getElementById("deleteBtn");
    deleteBtn?.addEventListener("click", async () => {
        if (!confirm("Delete this blog permanently?")) return;
        setLoading(deleteBtn, true);
        try {
            const res = await fetch(`/api/v1/blogs/${deleteBtn.dataset.id}`, { method: "DELETE" });
            if (res.ok) { window.location.href = "/"; }
            else { toast("Couldn't delete."); setLoading(deleteBtn, false); }
        } catch { toast("Network error."); setLoading(deleteBtn, false); }
    });
</script>
