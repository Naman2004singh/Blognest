<!-- Profile header: cover banner + overlapping avatar -->
<section class="relative">
    <!-- cover -->
    <div class="h-48 sm:h-60 w-full overflow-hidden bg-gradient-to-br from-moss/20 to-ink/10">
        <% if (user.coverImage) { %>
            <img src="<%= user.coverImage %>" alt="" class="w-full h-full object-cover" />
        <% } %>
    </div>

    <div class="max-w-5xl mx-auto px-5">
        <div class="flex items-end gap-4 -mt-12 sm:-mt-14">
            <img src="<%= user.avatar %>" alt=""
                class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl object-cover ring-4 ring-paper shadow-md bg-paper" />
            <div class="pb-2">
                <h1 class="font-display text-3xl font-semibold leading-tight"><%= user.fullName %></h1>
                <p class="text-ink/50 text-sm"><%= user.email %></p>
            </div>
            <a href="/blogs/new"
            class="ml-auto mb-2 bg-ink text-paper font-medium px-5 py-2.5 rounded-full hover:bg-moss transition text-sm">
                Write a story
            </a>
        </div>
    </div>
</section>

<div class="max-w-5xl mx-auto px-5 py-10">
    <!-- stats -->
    <div class="flex gap-8 mb-10 pb-8 border-b border-ink/10">
        <div>
            <div class="font-display text-3xl font-semibold"><%= blogs.length %></div>
            <div class="text-sm text-ink/50">Stories</div>
        </div>
        <div>
            <div class="font-display text-3xl font-semibold"><%= blogs.reduce((s,b)=>s+Number(b.likeCount),0) %></div>
            <div class="text-sm text-ink/50">Total likes</div>
        </div>
        <div>
            <div class="font-display text-3xl font-semibold"><%= blogs.filter(b=>b.isPublished).length %></div>
            <div class="text-sm text-ink/50">Published</div>
        </div>
    </div>

    <h2 class="font-display text-2xl font-semibold mb-6">Your stories</h2>

    <% if (blogs.length === 0) { %>
        <div class="text-center py-16 bg-white rounded-2xl border border-ink/10">
            <p class="font-display text-xl text-ink/40 mb-3">You haven't written anything yet.</p>
            <a href="/blogs/new" class="text-moss font-medium hover:underline">Start your first story →</a>
        </div>
    <% } else { %>
        <div class="space-y-4">
            <% blogs.forEach(function(blog) { %>
                <div class="flex items-center gap-4 bg-white rounded-2xl border border-ink/10 p-4 hover:border-moss/40 transition">
                    <div class="w-20 h-20 rounded-xl overflow-hidden bg-ink/5 shrink-0">
                        <img src="<%= blog.thumbnail %>" alt="" class="w-full h-full object-cover" />
                    </div>
                    <div class="flex-1 min-w-0">
                        <a href="/blogs/<%= blog.id %>" class="font-display text-lg font-semibold hover:text-moss transition line-clamp-1"><%= blog.title %></a>
                        <div class="flex items-center gap-2 text-sm text-ink/45 mt-1">
                            <span class="px-2 py-0.5 rounded-full bg-moss/10 text-moss text-xs font-medium"><%= blog.category %></span>
                            <span><%= blog.likeCount %> likes · <%= blog.commentCount %> comments</span>
                            <% if (!blog.isPublished) { %><span class="px-2 py-0.5 rounded-full bg-clay/10 text-clay text-xs font-medium">Draft</span><% } %>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <a href="/blogs/<%= blog.id %>/edit" class="px-3 py-1.5 rounded-full border border-ink/15 text-sm font-medium text-ink/70 hover:border-moss hover:text-moss transition">Edit</a>
                        <button data-id="<%= blog.id %>" class="delBtn px-3 py-1.5 rounded-full border border-clay/30 text-sm font-medium text-clay hover:bg-clay hover:text-white transition">Delete</button>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</div>

<%- include('../partials/ui-helpers') %>
<%- include('../partials/delete-script') %>
